# Cấu hình máy chủ TRINHMUASAMONLINE Backend
PORT=5000
NODE_ENV=development

# Kết nối PostgreSQL (Hỗ trợ PostgreSQL thật hoặc engine PostgreSQL cục bộ)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trinhmuasam?schema=public

# Cấu hình xác thực JWT
JWT_SECRET=nam_a_bank_qtts_sso_secret_key_2026_super_secure_jwt
JWT_EXPIRES_IN=7d

# Đường dẫn thư mục upload file đính kèm
UPLOAD_DIR=./uploads
